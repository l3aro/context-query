{
  "name": "context-query",
  "version": "0.1.0",
  "description": "Code analysis tool for LLMs - TypeScript port",
  "type": "module",
  "private": true,
  "bin": {
    "ctxq": "./src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build src/cli.ts --outdir ./dist --target bun",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.21.2",
