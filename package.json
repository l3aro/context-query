    "tree-sitter-php": "^0.22.6",
    "ollama": "^0.5.14",
    "better-sqlite3": "^11.7.0",
    "sqlite-vec": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
